From b77d7a101cc20ba683a11504369f640d92d8b281 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 15 Nov 2026 21:18:54 +0000
Subject: [PATCH] Move the combined Canopy view section into its own file

The 'What's happening above your trees' diagram, sensor inspector and
weather simulator now live in frontend/canopy-view.js (markup) and
frontend/canopy-view.css (its layout styles). index.html keeps a
#canopy-view-slot where the section appears; app.js imports
canopy-view.js first so the section exists before its controls are wired.
Same ids, same look, same behaviour.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GM9hhDcKCyyqoEnyeRVmi7
---
 frontend/app.js          |  1 +
 frontend/canopy-view.css |  8 ++++++
 frontend/canopy-view.js  | 61 ++++++++++++++++++++++++++++++++++++++++
 frontend/index.html      |  9 ++----
 frontend/styles.css      |  8 ------
 5 files changed, 72 insertions(+), 15 deletions(-)
 create mode 100644 frontend/canopy-view.css
 create mode 100644 frontend/canopy-view.js

diff --git a/frontend/app.js b/frontend/app.js
index 662304f..1cb2e01 100644
--- a/frontend/app.js
+++ b/frontend/app.js
@@ -1,3 +1,4 @@
+import './canopy-view.js'; // must stay first: puts the Canopy view section into the page
 import { mountAudit } from './audit-ui.js';
 import { simulateWeather, loadOrchardForecast, forecastWindow, presetClockMinutes } from './weather.js';
 import { assertSnapshot, assertFresh, deltas, escapeHTML as esc, signed } from './contract.js';
diff --git a/frontend/canopy-view.css b/frontend/canopy-view.css
new file mode 100644
index 0000000..c67c698
--- /dev/null
+++ b/frontend/canopy-view.css
@@ -0,0 +1,8 @@
+/* Canopy view section (markup in canopy-view.js). Shared panel styles stay in styles.css. */
+.clock-end{font-size:.75rem;color:var(--muted, #6b7468);margin:0 .35rem;white-space:nowrap}
+/* Weather simulator sits inside the "What's happening above your trees" card, under the diagram it drives. */
+#orchard #weather-panel{border:0;border-top:1px solid var(--line);border-radius:0;background:transparent;margin:22px 0 4px;padding:20px 0 0}
+#orchard #weather-title{font-size:1.05rem;letter-spacing:.01em;margin:0}
+#orchard #weather-panel .session-actions{flex-wrap:wrap;gap:10px}
+#orchard #weather-panel .session-actions label:has(#weather-minute){display:flex;align-items:center;gap:4px;flex:1;min-width:260px}
+#orchard #weather-panel #weather-minute{flex:1;min-width:120px;accent-color:var(--green)}
diff --git a/frontend/canopy-view.js b/frontend/canopy-view.js
new file mode 100644
index 0000000..0ccf003
--- /dev/null
+++ b/frontend/canopy-view.js
@@ -0,0 +1,61 @@
+// Canopy view: "What's happening above your trees" diagram, sensor inspector and weather simulator.
+// app.js imports this module first, so the section is in the page before app.js wires up its controls
+// (orchard-svg, sensor-*, weather-*). Element ids are unchanged.
+const markup = `
+<section id="orchard" class="orchard-panel" aria-labelledby="orchard-title">
+<div class="section-heading">
+<div>
+<p class="eyebrow">WHAT’S HAPPENING ABOVE YOUR TREES</p>
+<h2 id="orchard-title">The invisible, made visible.</h2>
+</div>
+<button id="motion-toggle" class="outline-button" aria-pressed="false">Pause animation <span aria-hidden="true">Ⅱ</span>
+</button>
+</div>
+<div class="orchard-layout">
+<div class="diagram-wrap">
+<div id="orchard-svg">
+</div>
+<p class="diagram-caption">Illustrative cross-section · Wind badges use compass direction · Not a plume model</p>
+</div>
+<aside class="sensor-inspector">
+<span class="eyebrow">INSPECT A SENSOR HEIGHT</span>
+<div class="sensor-tabs" role="group" aria-label="Sensor height">
+<button data-height="canopy_30ft" aria-pressed="true">30 ft</button>
+<button data-height="ground_5ft" aria-pressed="false">5 ft</button>
+</div>
+<h3 id="sensor-title">Above canopy</h3>
+<dl id="sensor-details">
+</dl>
+<div class="layer-note" id="layer-note">
+</div>
+</aside>
+</div>
+<section id="weather-panel" class="session-panel" aria-labelledby="weather-title">
+      <h2 id="weather-title">Weather simulator</h2>
+      <div class="session-actions">
+<button id="weather-play" class="outline-button">Play</button>
+<button id="weather-reset" class="outline-button">Reset sliders</button>
+<label>Time of day <span class="clock-end">12 AM</span>
+<input id="weather-minute" type="range" min="0" max="1439" step="1" value="0" aria-label="Time of day, 12:00 AM to 11:59 PM">
+<span class="clock-end">11:59 PM</span> <output id="weather-clock">
+</output>
+</label>
+</div>
+      <div id="weather-sliders">
+</div>
+      <div class="session-actions">
+<label>Forecast orchard <select id="weather-location">
+<option value="fresno">Fresno, CA</option>
+<option value="willcox">Willcox, AZ</option>
+</select>
+</label>
+<button id="weather-fetch" class="outline-button">Load NWS forecast</button>
+</div>
+      <p id="weather-network" role="status">
+</p>
+    </section>
+</section>`;
+
+const slot = document.getElementById('canopy-view-slot');
+if (!slot) throw new Error('Canopy view slot (#canopy-view-slot) is missing from index.html');
+slot.outerHTML = markup.trim();
