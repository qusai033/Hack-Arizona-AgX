+  await page.clock.runFor(30000); // issuance age 6 h + 15 s
+  await expect(page.locator('#decision-title')).toContainText('DATA UNAVAILABLE');
+  await expect(page.locator('#forecast-source')).toContainText('FORECAST UNAVAILABLE');
